# Local paths for the helper scripts. Copy to scripts/local.env (ignored by git) and edit;
# environment variables of the same name take precedence, and deploy.sh / restore.sh also take
# the game directory as their first argument.

# Game directory that holds sl.interposer.dll (deploy.sh, restore.sh)
METALSTREAM_GAME_DIR="$HOME/Games/MyGame"

# Wine with Apple GPTk (D3DMetal) and its prefix (run_gptk_tests.sh)
WINE_BIN="$HOME/Library/Application Support/Starward/runtime/wine/bin/wine"
WINEPREFIX="$HOME/Library/Application Support/Starward/runtime/wineprefix_nap"
